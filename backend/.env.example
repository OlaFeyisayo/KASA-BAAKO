# Copy this file to backend/.env and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# --- Server ---
PORT=3000
# Dashboard's local URL, for CORS. Default Vite port is 5173.
DASHBOARD_ORIGIN=http://localhost:5173

# --- Auth ---
# Shared MTN-staff dashboard login password (pick anything for local dev).
DASHBOARD_PASSWORD=
# Shared key for machine-to-machine callers of POST /report (pick anything for local dev).
SERVICE_API_KEY=
# Secret appended to the USSD webhook URL as ?token=... (pick anything for local dev).
USSD_WEBHOOK_TOKEN=

# --- Anthropic (case-builder AI) ---
ANTHROPIC_API_KEY=

# --- Khaya AI / GhanaNLP (Twi speech-to-text and text-to-speech) ---
KHAYA_API_KEY=

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
